# ============================================================
# Smart Home AI 推理 / Agent 服务 环境变量模板
# 用法：复制本文件为 .env，填入真实值；.env 已被 .gitignore 忽略，不会提交
# ============================================================

# ---------- 云端大脑（主用，OpenAI 兼容写法）----------
# DeepSeek：Function Calling 强、成本低  https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 备选：阿里云百炼 DashScope（一个 key 同时支持对话与向量）
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_CHAT_MODEL=qwen-plus
# DASHSCOPE_EMBED_MODEL=text-embedding-v3

# ---------- 本地兜底（Ollama，可完全离线）----------
OLLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen3.5:4b

# ---------- 向量 Embedding ----------
# 默认本地中文向量（离线、无需 key）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 业务后端（Agent 工具调用 Java REST）----------
SMART_HOME_SERVER_BASE_URL=http://localhost:8080

# ---------- 向量库持久化目录 ----------
CHROMA_DIR=./data/chroma
